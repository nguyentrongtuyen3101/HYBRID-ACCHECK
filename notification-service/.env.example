PORT=8002
# Cùng Postgres với api-service được; service này chỉ dùng schema "notification"
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hybrid_accheck
# Supabase: dùng đúng connection string của api-service (sslmode=require được hiểu giống bên Go)
# Dùng vhost riêng (vd /reqsentinel) nếu RabbitMQ dùng chung với dự án khác:
#   rabbitmqctl add_vhost reqsentinel && rabbitmqctl set_permissions -p reqsentinel <user> ".*" ".*" ".*"
RABBITMQ_URL=amqp://guest:guest@localhost:5672/reqsentinel
# Phải trùng JWT_SECRET của api-service (để xác thực WebSocket / REST)
JWT_SECRET=
# Chỉ cần khi FE kết nối thẳng (không qua proxy)
CORS_ALLOWED_ORIGINS=

# SMTP gửi email mời / reset mật khẩu. Để trống SMTP_HOST = chỉ ghi log.
# Dev: chạy Mailpit (docker compose có sẵn) → SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASSWORD=<App Password 16 ký tự>
# Để trống MAIL_FROM = "ReqSentinel <SMTP_USER>"
MAIL_FROM=

EVENT_MAX_RETRIES=5
