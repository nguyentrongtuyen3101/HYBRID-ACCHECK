# Dùng cho docker compose (copy thành .env)
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ALLOW_SIGNUP=true
ML_SERVICE_TOKEN=change-me-internal-token
POSTGRES_PASSWORD=postgres
# Link trong email mời / reset mật khẩu trỏ về đây
WEB_URL=http://localhost:8080
JOB_WORKERS=1

# Để trống = email đi vào Mailpit (http://localhost:8025). Điền để gửi email thật.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ReqSentinel <no-reply@reqsentinel.local>

# Cổng publish ra máy (đổi nếu trùng)
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5433
RABBITMQ_UI_PORT=15673
MAILPIT_UI_PORT=8025
