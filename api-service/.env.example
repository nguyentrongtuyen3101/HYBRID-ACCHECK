PORT=8000
LOG_LEVEL=INFO

# Chấp nhận cả dạng SQLAlchemy cũ (postgresql+asyncpg://...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hybrid_accheck?sslmode=disable

# Bắt buộc, tối thiểu 32 ký tự. Sinh nhanh: openssl rand -hex 32
JWT_SECRET=
TOKEN_TTL=24h
# false = chỉ admin mới tạo được tài khoản
ALLOW_SIGNUP=true

# Admin đầu tiên, chỉ tạo khi DB chưa có admin nào
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

ML_SERVICE_URL=http://localhost:8001
# Phải trùng INTERNAL_TOKEN bên ml-service
ML_SERVICE_TOKEN=change-me-internal-token
ML_TIMEOUT=120s

# Đẩy sự kiện sang notification-service. Để trống = sự kiện chỉ nằm trong bảng outbox_events
# Dùng vhost riêng (vd /reqsentinel) nếu RabbitMQ dùng chung với dự án khác:
#   rabbitmqctl add_vhost reqsentinel && rabbitmqctl set_permissions -p reqsentinel <user> ".*" ".*" ".*"
RABBITMQ_URL=amqp://guest:guest@localhost:5672/reqsentinel
# URL của web-app, dùng trong link email (mời thành viên, reset mật khẩu)
WEB_URL=http://localhost:5173
# Số worker chạy job "phân tích cả project"
JOB_WORKERS=1

# Chỉ cần khi FE gọi thẳng API từ origin khác (không qua proxy)
CORS_ALLOWED_ORIGINS=
# true khi API đứng sau nginx/proxy tin cậy (lấy IP thật từ X-Real-IP)
TRUST_PROXY=false
