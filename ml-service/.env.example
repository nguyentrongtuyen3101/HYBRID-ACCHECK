# Token nội bộ, phải trùng ML_SERVICE_TOKEN bên api-service. Để trống = tắt kiểm tra.
INTERNAL_TOKEN=change-me-internal-token
WARMUP_ON_STARTUP=true

DEBERTA_MODEL_NAME=microsoft/deberta-v3-base
DEBERTA_MODEL_DIR=data/models/deberta-extractor
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=data/models

ALIGNMENT_THRESHOLD=0.55
ROLE_WEIGHT=0.35
ACTION_WEIGHT=0.35
RESOURCE_WEIGHT=0.30

LOG_LEVEL=INFO
